# Text: ark | openai | anthropic | mock
TEXT_PROVIDER=ark
# Embedding: ark | openai | mock (anthropic will fall back to local vectors)
EMBEDDING_PROVIDER=ark

# Agent runtime: pi | legacy
AGENT_RUNTIME=pi
# Pi uses a ReAct-style model -> tool -> toolResult -> model loop.
AGENT_THINKING_LEVEL=off
AGENT_TOOL_EXECUTION=sequential
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_MODEL_TURNS=6

# Unlocked Skill/MCP capability runtime.
CAPABILITY_RUNTIME_ENABLED=true
CAPABILITY_MAX_TOOLS_PER_TURN=16
CAPABILITY_CALL_TIMEOUT_MS=45000
MCP_DISCOVERY_TTL_MS=300000
# Required for production HTTP MCP servers and Skill HTTP actions, comma-separated.
CAPABILITY_HTTP_ALLOWED_HOSTS=
# stdio is off by default. If enabled, allow only explicit executable names/paths.
MCP_ALLOW_STDIO=false
MCP_STDIO_ALLOWED_COMMANDS=

# Bounded parallel Subagent orchestration. The parent Pi model decides whether to delegate
# only after a deterministic multi-task router exposes delegate_parallel_tasks.
SUBAGENT_RUNTIME_ENABLED=true
SUBAGENT_MAX_CONCURRENCY=3
SUBAGENT_MAX_TASKS_PER_CALL=4
# Current release intentionally disallows recursive delegation.
SUBAGENT_MAX_DEPTH=1
SUBAGENT_MAX_MODEL_TURNS=4
SUBAGENT_MAX_OUTPUT_CHARACTERS=8000

# Durable Plan-Execute runtime. `inline` is convenient for one process; production should
# run scripts/deep-agent-worker.js separately and set both processes to `external`.
DEEP_AGENT_RUNTIME_ENABLED=true
DEEP_AGENT_WORKER_MODE=inline
DEEP_AGENT_WORKER_POLL_MS=1000
DEEP_AGENT_MAX_CONCURRENCY=2
DEEP_AGENT_MAX_NODES=16
DEEP_AGENT_MAX_REPLANS=2
DEEP_AGENT_NODE_MAX_ATTEMPTS=2
DEEP_AGENT_LEASE_SECONDS=180
DEEP_AGENT_APPROVAL_TTL_SECONDS=86400
DEEP_AGENT_AUTO_REPLAN=true
DEEP_AGENT_MAX_MODEL_TURNS=6
DEEP_AGENT_MAX_OUTPUT_CHARACTERS=16000

# Sandboxed file, Bash and document tools. Keep disabled until an OpenSandbox control plane
# and the image from sandbox/Dockerfile are deployed. Production rejects the local provider.
SANDBOX_RUNTIME_ENABLED=false
SANDBOX_PROVIDER=opensandbox
SANDBOX_IMAGE=open-character-memory/sandbox:0.1.0
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_COMMAND_TIMEOUT_MS=60000
SANDBOX_MAX_OUTPUT_CHARACTERS=24000
SANDBOX_MAX_ARTIFACT_BYTES=10485760
SANDBOX_ALLOWED_PROGRAMS=bash,python,python3,node,sh
SANDBOX_NETWORK_ALLOWED_HOSTS=
OPEN_SANDBOX_DOMAIN=127.0.0.1:8080
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_USE_SERVER_PROXY=true
# Local provider is development-only; commands remain disabled unless this is explicitly true.
SANDBOX_LOCAL_UNSAFE_COMMANDS=false
SANDBOX_WORKSPACE_ROOT=./data/sandboxes
ARTIFACT_ROOT=./data/artifacts

# Headless Memory Runtime. The bearer key can only access /v1/memory/*.
MEMORY_TENANT_ID=default
MEMORY_SERVICE_API_KEY=replace-with-a-long-random-service-key
MEMORY_WORKER_POLL_MS=750
MEMORY_JOB_MAX_ATTEMPTS=3

# Graph query layer: sqlite | neo4j. SQLite remains the current source of truth.
GRAPH_STORE=sqlite
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=false
NEO4J_PROJECTION_BATCH_SIZE=10

ARK_API_KEY=replace-me
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=deepseek-v4-flash-ga-260731
ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
ARK_REQUEST_TIMEOUT_MS=180000
# provider_managed is compatible with model names. common_prefix is opt-in and requires a compatible Ark endpoint ID.
ARK_PREFIX_CACHE_MODE=provider_managed
ARK_PREFIX_CACHE_TTL_SECONDS=86400

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=replace-me
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
ANTHROPIC_VERSION=2023-06-01

ADMIN_PASSWORD=replace-with-a-strong-password
HOST=127.0.0.1
PORT=4173
BASE_PATH=
DATABASE_PATH=./data/memory-agent.db
