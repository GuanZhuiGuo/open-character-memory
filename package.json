{
  "name": "open-character-memory",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "exports": {
    "./core": "./packages/memory-core/src/index.js",
    "./sdk": "./packages/sdk/index.js",
    "./adapters/generic": "./packages/adapters/generic/index.js",
    "./adapters/pi": "./packages/adapters/pi/index.js"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "start:mock": "node scripts/start-mock.js",
    "test": "node --test",
    "eval": "node scripts/run-memory-evals.js",
    "eval:long-term:real": "node scripts/run-long-term-memory-badcases.js",
    "check:open-source": "node scripts/open-source-check.js",
    "mcp:memory": "node packages/mcp-server/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dompurify": "3.4.13",
    "marked": "16.4.1",
    "neo4j-driver": "6.2.0"
  }
}
